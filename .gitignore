# секреты
.env
# Резервные копии .env: в них боевые токены и пароли, в репозиторий не попадают.
# Если копия нужна в истории — хранить вне репозитория.
.env.bak-*
.env.*.bak*
.env.example.bak*
*.session

# данные
data/
*.db
*.sqlite3
backups/
# Логи — локальные: содержат идентификаторы клиентов, в истории им не место.
logs/

# тяжёлые первоисточники исследований: PDF/HTML-выгрузки лежат локально,
# ссылки на них есть в .research/*.md
.research/**/*.pdf
.research/**/*.html

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ide / os
.DS_Store
.idea/
.vscode/
