# ============================================================
#  Kometa — конфигурация. Скопируй в .env и заполни.
#  ВАЖНО: .env не коммитится в git.
# ============================================================

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=
# --- Бот уведомлений (только для команды) ---
# Отдельный бот для оперативных сообщений: оплаты, заявки, алерты нод,
# сводка за сутки. Пусто — уведомления идут основным ботом, как раньше.
# Токен берётся у @BotFather; админ должен нажать /start в этом боте.
NOTIFY_BOT_TOKEN=
# Куда слать уведомления: id чатов через запятую. Пусто — берём ADMIN_IDS.
# Личка: свой id (например 926194553). Группа или канал: id вида -100…
# (бот должен быть в этом чате; в канал — админом).
NOTIFY_CHAT_IDS=
# Бот уведомлений настроен, но не поднялся (токен отозван, сеть) —
# отправить уведомление основным ботом. false — не отправлять вовсе.
NOTIFY_FALLBACK_TO_MAIN=true
# Час ежедневной сводки по UTC (18 = 21:00 МСК). Пусто — сводку не шлём.
NOTIFY_DIGEST_HOUR_UTC=18
# Показывать в уведомлении об оплате итог дня («сегодня: 3 оплаты»)
NOTIFY_PAYMENT_TOTALS=true
# Сообщать об ошибках в обработчиках (одна и та же ошибка — раз в 10 минут)
NOTIFY_ERRORS=true
# Ссылка на канал: кнопка «Канал» и кнопка «Подписаться» на экране гейта
CHANNEL_URL=
# --- Обязательная подписка на канал ---
# Требовать подписку на канал, пока у человека НЕТ активной подписки на сервис.
# Включать, только когда бот добавлен в канал АДМИНИСТРАТОРОМ: иначе Telegram
# не показывает участников и проверять нечем (см. CHANNEL_GATE_FAIL_OPEN).
CHANNEL_GATE_ENABLED=false
# Канал для проверки: @юзернейм или числовой id (приватный — вида -100…).
# Пусто — берём имя из CHANNEL_URL, если это публичная ссылка t.me/<имя>.
# Ссылку-приглашение (t.me/+…) проверить нельзя — нужен именно id.
CHANNEL_ID=
# Сколько часов доверять успешной проверке, не дёргая Telegram API (0 — каждый раз)
CHANNEL_GATE_CACHE_HOURS=12
# Что делать, если проверить не удалось (бот не админ, сеть, лимиты API):
# true — пускаем всех (гейт не работает, но бот жив), false — показываем экран
# подписки всем. О сбое бот пишет в лог и раз в час — админам.
CHANNEL_GATE_FAIL_OPEN=true
# Ник поддержки без @ (например: kometa_support).
# Банк не принимает группу — только юзернейм, почту или тикет-систему.
SUPPORT_USERNAME=
# Юзернейм бота без @ — подставляется в юридические документы
# ⚠️ Согласован с банком 06.10.2026: менять юзернейм нельзя —
#    иначе проект придётся согласовывать заново.
BOT_USERNAME=
# Почта поддержки (необязательно; если заполнена — попадёт в документы вместе с ником)
SUPPORT_EMAIL=

# --- Юридические документы (политика, соглашение, цены) ---
# Исполнитель: ФИО самозанятого или наименование ИП/ООО. Банк принимает
# документы только с реальными реквизитами — плейсхолдеры не подойдут.
LEGAL_OPERATOR_NAME=
# ИНН исполнителя (у самозанятого — 12 цифр)
LEGAL_OPERATOR_INN=
# Дата актуальной редакции документов, ДД.ММ.ГГГГ
LEGAL_UPDATED_AT=06.10.2026
# Постоянные ссылки на опубликованные документы (Telegra.ph или сайт).
# Пусто — бот отдаёт полный текст документа прямо в чате.
# Заполняются автоматически: .venv/bin/python scripts/publish_legal.py
PRIVACY_URL=
TERMS_URL=
PRICING_URL=
# Токен анонимного аккаунта Telegra.ph: нужен, чтобы обновлять те же страницы,
# не меняя ссылки. Создаётся скриптом publish_legal.py, в git не коммитится.
TELEGRAPH_ACCESS_TOKEN=
# Сколько локаций и какие — фраза целиком, попадает в документы и на экран цен
LOCATIONS_NOTE=несколько локаций с переключением в один тап

# --- База данных ---
# По умолчанию SQLite в ./data/kometa.db
DB_URL=

# --- Панель управления VPN ---
# fake — локальная заглушка для разработки, xui — реальная панель 3x-ui
PANEL_TYPE=fake
# Адрес панели с портом, например: http://150.241.106.75:54321
PANEL_URL=
# Токен API панели (3x-ui: Настройки → API-токен) ИЛИ логин/пароль
PANEL_TOKEN=
PANEL_USERNAME=
PANEL_PASSWORD=
# ID инбаундов через запятую, из которых собираем подписку (например: 1,2)
PANEL_INBOUND_IDS=
# Базовый адрес сервиса подписок панели (если отличается), например: http://IP:2096/sub/
PANEL_SUB_BASE=

# --- Наш веб-слой (ссылка-подписка /sub/<token>) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный адрес этого сервиса (используется в ссылках)
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Режим ограничений оператора: наружу проходят только TCP 80/443/22, поэтому
# UDP-профили (AmneziaWG/WireGuard, Hysteria2, TUIC) из подписки убираются —
# иначе клиент долбится в мёртвый профиль и считает, что VPN сломан.
# Включать, когда у абонентов активен режим ограничений; выключать после снятия.
# Подробности: docs/БЕЛЫЕ-СПИСКИ-ВНЕДРЕНИЕ.md
SUBSCRIPTION_TCP_ONLY=false

# URL для замера задержки в клиенте (Clash url-test, sing-box urltest).
# Пусто = <PUBLIC_BASE_URL>/ping, если адрес публичный (наш 204-эндпоинт),
# иначе внешний generate_204. Свой адрес нужен потому, что при ограничениях
# связи внешний тест-URL недоступен и клиент помечает мёртвыми ВСЕ профили,
# включая живые: «нет пинга» вместо рабочего подключения.
# Если подписка отдаётся не с публичного адреса — указать вручную, например
# https://sub.example/ping или http://<разрешённый-хост>/generate_204
SUBSCRIPTION_TEST_URL=

# Проба нод «глазами клиента»: TCP до порта инбаунда + замер задержки.
# Панель может отвечать, а порт клиента не пускать — тогда поднимается алерт
# node_probe_failed, а в админке и на странице подключения видно пинг.
# Если проба не дошла до порта (панель не отдала инбаунды, у ноды пуст host),
# алерт не поднимается: состояние порта неизвестно, причина ложится в
# nodes.last_probe_error. Разбор ID инбаундов: python -m app.tools.check_nodes.
NODE_PROBE_ENABLED=true
NODE_PROBE_TIMEOUT=5.0

# Домен дежурного DNS-канала (например t.example.com). Сам туннель живёт
# отдельным приложением и в подписку не попадает — домен нужен, чтобы отчёт
# о готовности (/emergency, app.tools.emergency_check) знал, что канал есть.
# Развёртывание: scripts/add_dns_tunnel.sh, подробности: docs/DNS-ТУННЕЛЬ-2026-10.md
DNS_TUNNEL_DOMAIN=

# --- Админ-панель (/admin) ---
# Пароль для входа. Пусто = панель выключена (безопасно по умолчанию).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(9))"
ADMIN_PANEL_PASSWORD=
# Ключ подписи сессионной cookie. Пусто = используется токен бота.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PANEL_SECRET=
# Время жизни сессии (часы)
ADMIN_SESSION_HOURS=12
# Панель доступна только с localhost — так безопасно работать без домена и HTTPS.
# Заходим через SSH-туннель: ssh -L 8090:127.0.0.1:8090 root@IP
ADMIN_LOCAL_ONLY=true
# Если нужен доступ с домашнего IP — перечисли их через запятую (при ADMIN_LOCAL_ONLY=true)
ADMIN_ALLOWED_IPS=
# Доверять заголовку X-Forwarded-For. Включать ТОЛЬКО если панель стоит за своим
# реверс-прокси: иначе IP подделывается одним заголовком и «только localhost»
# перестаёт что-либо защищать.
ADMIN_TRUST_PROXY=false
# Роли (владелец / модератор / поддержка) заводятся в разделе «Команда и роли»
# уже внутри панели; пароль выше остаётся резервным входом владельца.

# --- Тарифы и лимиты (значения по умолчанию, меняются в БД) ---
TRIAL_DAYS=3
TRIAL_GB=0
TRIAL_DEVICES=1
# Добавлять накопленные бонусные дни к триалу: false — дни идут на первую ОПЛАТУ.
TRIAL_APPLIES_BONUS_DAYS=false
ORDER_TTL_MINUTES=30

# --- Реферальная программа и промокоды ---
# Друг по реферальной ссылке получает скидку 50% на первую оплату,
# пригласивший — +30 дней. Скидка одна на аккаунт и только на первую оплату.
REFERRAL_BONUS_DAYS_REFERRER=14
REFERRAL_BONUS_DAYS_INVITED=3
REFERRAL_DISCOUNT_PERCENT=30
REFERRAL_BONUS_DAYS_RENEWAL=14
# Потолок скидки в рублях: 0 — без потолка. Например, 300 — чтобы годовой
# тариф не отдавать вдвое дешевле.
REFERRAL_DISCOUNT_MAX_RUB=240
# Защита от накрутки: сколько наград одному человеку в календарный месяц.
REFERRAL_MAX_REWARDS_PER_MONTH=10
# Сколько раз персональный промокод может сработать (0 — без ограничения).
PROMO_REFERRAL_USES_LIMIT=50

# Подарочные сертификаты: подписка в подарок с активацией позже.
GIFT_ENABLED=true
GIFT_VALID_DAYS=365
GIFT_MARKUP_PERCENT=25
GIFT_BUYER_BONUS_DAYS=7

# --- Приём платежей ---
# Реквизиты для ручной оплаты (СБП/карта). Показываются в боте при выборе этого способа.
MANUAL_PAYMENT_DETAILS=
MANUAL_PAYMENT_NOTE=В комментарии к переводу укажи номер заказа
# Токен CryptoBot (Crypto Pay) от @CryptoBot → Crypto Pay → Create App
CRYPTOBOT_TOKEN=
# Курс для счетов в крипте: сколько рублей стоит 1 USDT (обновлять вручную!)
CRYPTO_RUB_PER_USDT=95.0
# Telegram Stars
STARS_ENABLED=true
# Сколько звёзд стоит 1 рубль — ТОЛЬКО запасной вариант: основная цена берётся
# из тарифа (Plan.price_stars). 0.91 ≈ 1.1 ₽/⭐: Telegram платит разработчику
# ~$0.013 за звезду (~1.2 ₽), поэтому курс 1:1 означал бы работу в убыток.
STARS_PER_RUB=0.91

# --- Автопроверка переводов по выписке банка ---
# Система сама подтверждает оплату и выдаёт подписку, когда видит поступление.
# Включить, когда настроен хотя бы один источник выписки (CSV или IMAP).
AUTOPAY_ENABLED=false
# Как часто проверять выписку (минуты)
AUTOPAY_INTERVAL_MINUTES=5
# Допуск при сверке суммы (копейки): 0 — строго
AUTOPAY_TOLERANCE_KOPECKS=0
# Файлы выписки, которые банк или скрипт складывает в папку
STATEMENT_CSV_GLOB=data/statements/*.csv
# Где хранить состояние обработки (чтобы не подтвердить платёж дважды)
STATEMENT_STATE_FILE=data/statement_state.json
# Почтовые уведомления банка (IMAP): включи, если банк присылает письма о поступлениях.
# Для Gmail/Яндекс нужен пароль приложения, а не обычный пароль.
BANK_IMAP_HOST=
BANK_IMAP_PORT=993
BANK_IMAP_USER=
BANK_IMAP_PASSWORD=
BANK_IMAP_FOLDER=INBOX
# Сообщать админам о поступлениях, которые не удалось сопоставить с заказом
AUTOPAY_NOTIFY_UNMATCHED=true

# --- WATA: карты РФ и зарубежные, СБП, T-Pay, SberPay ---
# Подключение: заявка на wata.pro → менеджер → личный кабинет merchant.wata.pro →
# «Терминалы» → создать access token (живёт 1–12 месяцев).
# ВАЖНО: WATA принимает запросы только с согласованных IP — сообщи менеджеру адрес сервера.
WATA_TOKEN=
# Боевой API; для тестов песочница: https://api-sandbox.wata.pro/api/h2h
WATA_BASE_URL=https://api.wata.pro/api/h2h
# Публичный ключ для проверки подписи вебхука (пусто — скачаем сами через API)
WATA_PUBLIC_KEY=
# Срок жизни платёжной ссылки в минутах (WATA: от 10 минут до 30 дней)
WATA_LINK_TTL_MINUTES=30
# Куда вернуть плательщика после оплаты (необязательно)
WATA_SUCCESS_REDIRECT_URL=
WATA_FAIL_REDIRECT_URL=
# Вебхук в личном кабинете WATA укажи такой:
#   https://<твой-домен-или-IP>:<WEB_PORT>/payments/wata/webhook

# --- Экономика приёма платежей (отчёт о доходности в админке) ---
# Комиссия канала в процентах от оборота.
# Прямой перевод на карту/по СБП без эквайринга — без комиссии.
FEE_PERCENT_MANUAL=0
# СБП через банк-партнёра (НСПК): QR-код или ссылка из банковского
# приложения — 8 % по условиям партнёра, снижается по мере роста оборота.
FEE_PERCENT_SBP=8
# Криптоплатежи: 5 % — ставка партнёра
FEE_PERCENT_CRYPTO=5
FEE_PERCENT_WATA=3.5
# Сколько теряется при выводе звёзд через Fragment
FRAGMENT_WITHDRAWAL_PERCENT=5
# Сколько долларов Telegram платит за одну звезду и курс доллара
STARS_PAYOUT_USD=0.013
USD_RUB_RATE=92
# Постоянные расходы в месяц (серверы, домен) — чтобы админка показывала прибыль, а не только оборот
MONTHLY_COSTS_RUB=750
# Оплаты звёздами от этой суммы попадают под контроль админа (риск краденых звёзд).
# При сетке от 120 ₽ самый крупный тариф — 860 ⭐, поэтому порог 800: иначе алерт
# не срабатывает вообще (см. docs/РЕВЬЮ-ЦЕНЫ-120.md).
STARS_WATCH_THRESHOLD=800
# Бот/сервис, где клиент может докупить звёзды, если у него их нет.
# Пусто — кнопка «Купить звёзды» в боте не показывается.
STARS_RESELLER_URL=

# --- Platega.io: карты, СБП/QR, крипта ---
# MerchantId (UUID) и API-ключ (X-Secret): кабинет platega.io → Настройки проекта.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Какие методы показывать клиенту (docs.platega.io + руководство менеджера):
#   2 — СБП/QR (+SberPay), 3 — ЕРИП, 11 — карты, 12 — зарубежные карты,
#   13 — крипта, 14 — SberPay, 16 — Alipay (от 10 CNY).
# Номера 6 (рекуррентные подписки) в списке нет: это не разовый платёж.
# Старый 10 (карты в прежней документации) автоматически заменяется на 11.
PLATEGA_METHODS=2,11
# Единицы суммы в API Platega: rubles (актуальная схема) или kopecks.
# ВАЖНО: не менять вслепую — ошибка в 100 раз. Подтверждается живой проверкой:
#   .venv/bin/python -m app.tools.platega_check --probe
PLATEGA_AMOUNT_UNIT=rubles
# Передавать metadata (userId, имя, IP) для антифрода Platega.
# Включать, если это требование менеджера: в схеме запроса поля нет.
PLATEGA_SEND_METADATA=false
# Куда вернуть плательщика после оплаты (необязательно)
# Подтверждать оплату вебхуком (нужен публичный HTTPS).
# false — режим «без сервера»: оплату подтверждает опрос раз в 2 минуты и
# кнопка «Проверить оплату»; публичный адрес тогда не нужен вовсе.
PLATEGA_USE_WEBHOOK=false
PLATEGA_RETURN_URL=
PLATEGA_FAILED_URL=
# Вебхук укажи в кабинете Platega (Настройки проекта → Callback URL):
#   https://<домен>/payments/platega/webhook
# Требования Platega: только HTTPS, публичный домен/IP, сертификат от доверенного
# центра (самоподписанный не годится), localhost и приватные IP запрещены.
# При сохранении адреса Platega шлёт пустой POST и ждёт 200 OK — наш хендлер
# на пустое тело отвечает 200 (см. app/web/payments.py).
# Деньги клиентов зачисляются после вебхука; если адрес не сохранён — оплаты
# не подтвердятся сами.

# --- Продажи и пробный доступ (два независимых флага) ---
# Пробный доступ: true — пускаем людей на TRIAL_DAYS дней бесплатно.
# Работает и при закрытых продажах — так запускали Германию 06.10.2026:
# люди пользуются 3 дня, оплата подключается позже.
TRIAL_ENABLED=true
TRIAL_CLOSED_NOTE=Пробный доступ откроется совсем скоро — следи за каналом.
# Продажи: false — деньги не принимаем (ни СБП, ни звёзды), показываем заглушку.
SALES_ENABLED=true
SALES_CLOSED_NOTE=Сервис готовится к запуску — продажи откроются совсем скоро.

# --- Прочее ---
LOG_LEVEL=INFO
