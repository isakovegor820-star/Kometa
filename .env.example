# ============================================================
#  Kometa — конфигурация. Скопируй в .env и заполни.
#  ВАЖНО: .env не коммитится в git.
# ============================================================

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=
# Ссылка на канал (для кнопки «Канал»)
CHANNEL_URL=
# Ник поддержки без @ (например: kometa_support)
SUPPORT_USERNAME=

# --- База данных ---
# По умолчанию SQLite в ./data/kometa.db
DB_URL=

# --- Панель управления VPN ---
# fake — локальная заглушка для разработки, xui — реальная панель 3x-ui
PANEL_TYPE=fake
# Адрес панели с портом, например: http://150.241.106.75:54321
PANEL_URL=
# Токен API панели (3x-ui: Настройки → API-токен) ИЛИ логин/пароль
PANEL_TOKEN=
PANEL_USERNAME=
PANEL_PASSWORD=
# ID инбаундов через запятую, из которых собираем подписку (например: 1,2)
PANEL_INBOUND_IDS=
# Базовый адрес сервиса подписок панели (если отличается), например: http://IP:2096/sub/
PANEL_SUB_BASE=

# --- Наш веб-слой (ссылка-подписка /sub/<token>) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный адрес этого сервиса (используется в ссылках)
PUBLIC_BASE_URL=http://127.0.0.1:8080

# --- Тарифы и лимиты (значения по умолчанию, меняются в БД) ---
TRIAL_DAYS=3
TRIAL_GB=10
TRIAL_DEVICES=1
REFERRAL_BONUS_DAYS_REFERRER=7
REFERRAL_BONUS_DAYS_INVITED=3
ORDER_TTL_MINUTES=30

# --- Приём платежей ---
# Реквизиты для ручной оплаты (СБП/карта). Показываются в боте при выборе этого способа.
MANUAL_PAYMENT_DETAILS=
MANUAL_PAYMENT_NOTE=В комментарии к переводу укажи номер заказа
# Токен CryptoBot (Crypto Pay) от @CryptoBot → Crypto Pay → Create App
CRYPTOBOT_TOKEN=
# Курс для счетов в крипте: сколько рублей стоит 1 USDT (обновлять вручную!)
CRYPTO_RUB_PER_USDT=95.0
# Telegram Stars
STARS_ENABLED=true
# Сколько звёзд стоит 1 рубль — ТОЛЬКО запасной вариант: основная цена берётся
# из тарифа (Plan.price_stars). 0.91 ≈ 1.1 ₽/⭐: Telegram платит разработчику
# ~$0.013 за звезду (~1.2 ₽), поэтому курс 1:1 означал бы работу в убыток.
STARS_PER_RUB=0.91

# --- Прочее ---
LOG_LEVEL=INFO
